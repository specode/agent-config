{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "system",
  "enabledModels": [
    "claude-bridge/claude-fable-5-2",
    "claude-bridge/claude-opus-5-5",
    "claude-bridge/claude-sonnet-5-5",
    "antigravity/gemini-4-neon",
    "google/gemini-4-neon",
    "openai-codex/gpt-6.2-astra",
    "openai-codex/gpt-6.2-sol",
    "xai/grok-4.7",
    "antigravity/claude-opus-5-5"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "externalEditor": "nvim",
  "collapseChangelog": true,
  "showHardwareCursor": true,
  "autocompleteMaxVisible": 8,
  "steeringMode": "all",
  "followUpMode": "all",
  "compaction": {
    "keepRecentTokens": 80000
  },
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/badlogic/pi-subagent",
    "npm:@ff-labs/pi-fff",
    "npm:@specode/pi-last-model-effort",
    "npm:@specode/pi-subscription-usage",
    "npm:@specode/pi-subscription-image",
    "npm:pi-claude-bridge",
    "npm:@specode/pi-antigravity"
  ],
  "hideThinkingBlock": true,
  "fullscreenScrollbar": "auto",
  "tuiMode": "fullscreen",
  "treeFilterMode": "no-tools"
}
