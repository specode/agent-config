{
  "theme": "light/light",
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "xai/grok-4.6:xhigh",
    "antigravity/gemini-3.7-flash",
    "deepseek/deepseek-v4-flash",
    "deepseek/deepseek-v4-pro"
  ],
  "externalEditor": "nvim",
  "collapseChangelog": true,
  "showHardwareCursor": true,
  "autocompleteMaxVisible": 8,
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "compaction": {
    "keepRecentTokens": 40000
  },
  "smartCompact": {
    "mode": "balanced",
    "profiles": {
      "balanced": {
        "keepRecentTokens": 40000
      }
    },
    "agentToolAccess": "disabled",
    "autoTriggerStrategy": "settled",
    "minContextPercent": 80,
    "contextGraphEnabled": false
  },
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "npm:@specode/pi-kimi-cu",
    "npm:@specode/pi-kimi-webbridge-bootstrap",
    "npm:@diegopetrucci/pi-openai-fast",
    "npm:pi-antigravity",
    "npm:pi-smart-compact"
  ],
  "hideThinkingBlock": true,
  "fullscreenScrollbar": "auto",
  "tuiMode": "fullscreen",
  "treeFilterMode": "no-tools"
}
